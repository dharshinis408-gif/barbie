#include <stdio.h>

#define MAX 100

void displayArray(int arr[], int n);

void heapSort(int arr[], int n);

void heapify(int arr[], int n, int i);

int main() {

 int arr[MAX];

 int n, i;

 printf("=========================================\n");

 printf(" HEAP SORT\n");

 printf("=========================================\n");

 printf("Enter number of elements: ");

 scanf("%d", &n);

 printf("Enter %d numbers:\n", n);

 for (i = 0; i < n; i++) {

 printf("Element [%d]: ", i);

 scanf("%d", &arr[i]);

 }

 printf("\nBefore sorting: ");

 displayArray(arr, n);

 heapSort(arr, n);

 printf("After sorting : ");

 displayArray(arr, n);

 return 0;

}

void displayArray(int arr[], int n) {

 int i;

 for (i = 0; i < n; i++)

 printf("%d ", arr[i]);

 printf("\n");

}

void heapify(int arr[], int n, int i) {

 int largest = i;

 int left = 2 * i + 1;

 int right = 2 * i + 2;

 int temp;

 if (left < n && arr[left] > arr[largest])

 largest = left;

 if (right < n && arr[right] > arr[largest])

 largest = right;

 if (largest != i) {

 temp = arr[i];

 arr[i] = arr[largest];

 arr[largest] = temp;

 heapify(arr, n, largest);

 }

}

 

void heapSort(int arr[], int n) {

 int i, temp;

 for (i = n / 2 - 1; i >= 0; i--)

 heapify(arr, n, i);

 for (i = n - 1; i > 0; i--) {

 temp = arr[0];

 arr[0] = arr[i];

 arr[i] = temp;

 heapify(arr, i, 0);

 }

}