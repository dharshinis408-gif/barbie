#include <stdio.h>
#include <stdlib.h>
#define MAX 100
int arr[MAX];
int n = 0;
/* ── Function Prototypes ── */
void inputArray();
void displayArray();
void insertElement();
void deleteElement();
void printMenu();
/* ── Main Function ── */
