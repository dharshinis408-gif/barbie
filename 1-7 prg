if (isFull()) {
printf("Queue Overflow!Cannot enqueue %d.\n",value);
return;
}
if(front == -1){
front=0;
}
rear++;
queue[rear]=value;
printf("%d enqueue into the queue.\n",value);
}
int dequeue(){
int dequeued_value;
if (isEmpty()) {
printf("Queue Underflow!Cannot dequeue from an empty queue.\n");
return-1;
}
dequeued_value=queue[front];
front++;
if(front>rear){
front=-1;
rear=-1;
}
